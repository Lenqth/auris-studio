<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What makes the built executable an application rather than a command.

  Without a bundle around it, macOS treats `auris-studio` as a tool: double-clicking it opens a
  Terminal window, it gets no name in the menu bar and no place in the Dock. The release workflow
  builds `Auris Studio.app` around the binary using this file, and rewrites the two version keys
  from the tag it is building.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Auris Studio</string>
    <key>CFBundleDisplayName</key>
    <string>Auris Studio</string>
    <!-- github.com/uthree/auris-studio, in the form Apple asks for. -->
    <key>CFBundleIdentifier</key>
    <string>io.github.uthree.auris-studio</string>
    <key>CFBundleExecutable</key>
    <string>auris-studio</string>
    <key>CFBundleIconFile</key>
    <string>auris-studio.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- Both rewritten at release time; the values here are what a local bundle gets. -->
    <key>CFBundleShortVersionString</key>
    <string>0.11.0</string>
    <key>CFBundleVersion</key>
    <string>0.11.0</string>
    <!-- Matches Cargo's deployment target and the shipped Core ML ONNX Runtime. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.4</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!--
      Recording and input monitoring open an input device. Without this sentence macOS refuses
      the bundle the microphone - it terminates the process or hands it silence - and nobody
      running from Terminal sees it, because there the request is Terminal's.
    -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Auris Studio records and monitors audio from the input you choose for an armed track.</string>
    <!--
      What makes Finder offer a .auris file to this application. Finder hands the file over as
      an open-document event rather than an argument; the window listens for both.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Auris Studio Project</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>io.github.uthree.auris-studio.project</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.uthree.auris-studio.project</string>
            <key>UTTypeDescription</key>
            <string>Auris Studio Project</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>auris</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
